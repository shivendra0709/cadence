rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuth() {
      return request.auth != null;
    }

    match /users/{userId} {
      allow read, write: if isAuth() && request.auth.uid == userId;
    }

    match /usernames/{username} {
      // Anyone authenticated can read usernames (to check availability)
      // Only the user themselves can write their uid to a username
      allow read: if isAuth();
      allow write: if isAuth() && request.resource.data.uid == request.auth.uid;
    }

    match /projects/{projectId} {
      // Users can read/write if they are in the memberIds array
      allow read, write: if isAuth() && request.auth.uid in resource.data.memberIds;
      // Allow creation if the user sets themselves in memberIds
      allow create: if isAuth() && request.auth.uid in request.resource.data.memberIds;
    }

    match /tasks/{taskId} {
      allow read, write: if isAuth() && request.auth.uid in resource.data.memberIds;
      allow create: if isAuth() && request.auth.uid in request.resource.data.memberIds;
    }

    match /dailyTasks/{taskId} {
      allow read, write: if isAuth() && request.auth.uid == resource.data.userId;
      allow create: if isAuth() && request.auth.uid == request.resource.data.userId;
    }

    match /activities/{activityId} {
      allow read, write: if isAuth() && request.auth.uid == resource.data.userId;
      allow create: if isAuth() && request.auth.uid == request.resource.data.userId;
    }

    match /notifications/{notificationId} {
      allow read, write: if isAuth() && request.auth.uid == resource.data.userId;
      allow create: if isAuth() && request.auth.uid == request.resource.data.userId;
    }
  }
}
